#!/bin/zsh
source "$HOME/.config/shells/zsh/init.zsh"



# # >>> fishros initialize >>>
# source /opt/ros/humble/setup.zsh
# # <<< fishros initialize <<<

# 安全 source - 文件不存在时不报错
[[ -f "$HOME/.cargo/env" ]] && . "$HOME/.cargo/env"


# WSL 命令找不到时自动补 .exe / AI Shell 兜底：
# 处理器统一由 shells/common/fn.sh 的 _ai_shell_install_handler 安装，
# 这里不要再定义 command_not_found_handler，否则会覆盖 AI 模式与跨会话持久设置。

[[ -f "$HOME/.local/bin/env" ]] && . "$HOME/.local/bin/env"

# Go TLS 证书路径（OpenCode Go 等静态编译二进制需要）
export SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
