#!/usr/bin/env bash
# =============================================================================
# count - 快速统计目录中的文件数量
# =============================================================================
set -eo pipefail

target="${1:-.}"
if [ ! -d "$target" ]; then
    echo "错误: 目录 '$target' 不存在" >&2
    exit 1
fi

find "$target" -type f | wc -l
