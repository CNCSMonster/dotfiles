#!/usr/bin/env bash

# 检查暂存区文件中是否存在 Git 冲突标志
check_conflicts() {
    local conflict_pattern="<<<<<<<|=======|>>>>>>>"

    while IFS= read -r -d '' file; do
        if git diff --cached -- "$file" | grep -q -E "$conflict_pattern"; then
            printf "%s\n" "$file"
        fi
    done < <(git diff --cached -z --name-only --diff-filter=ACMR)
}

# 主逻辑
main() {
    local conflict_files=()
    mapfile -t conflict_files < <(check_conflicts)

    if [ ${#conflict_files[@]} -gt 0 ]; then
        echo "检测到以下文件中存在 Git 冲突标志："
        printf "  %s\n" "${conflict_files[@]}"
        echo "中断提交，请解决冲突后再试。"
        exit 1
    else
        echo "未检测到 Git 冲突标志，继续提交。"
    fi
}

main "$@"
