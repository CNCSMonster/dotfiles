#!/usr/bin/env bash
# .githooks/pre-commit
# 本地提交前快速守卫：轻量、离线、快速（通常 < 1.5 秒）
set -euo pipefail

# 允许通过环境变量快速跳过
if [ "${SKIP_HOOKS:-0}" = "1" ]; then
    exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# 获取暂存区改动的文件列表（排除删除的文件）
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

echo "🔍 [pre-commit] 正在执行本地快速一致性检查..."

# 1. 冲突标记检查
if [ -x "shells/scripts/check-git-conflict" ]; then
    ./shells/scripts/check-git-conflict
fi

# 2. Shell 语法检查 (bash -n)
HAS_SHELL_ERRORS=0
while IFS= read -r file; do
    [ -z "$file" ] && continue
    # 仅针对 .sh 文件或 shells/scripts/ 下的文件做语法检查
    if [[ "$file" =~ \.sh$ ]] || [[ "$file" =~ ^shells/scripts/ ]]; then
        if [ -f "$file" ]; then
            if ! bash -n "$file" 2>&1; then
                echo "❌ Shell 语法错误: $file"
                HAS_SHELL_ERRORS=1
            fi
        fi
    fi
done <<< "$STAGED_FILES"

if [ "$HAS_SHELL_ERRORS" -ne 0 ]; then
    echo "❌ 存在 Shell 语法错误，终止提交。"
    exit 1
fi

# 3. 如果修改了 tool-installer 源码，检查是否同步更新了 vendor/tool-installer 并运行单元测试
NEED_TOOL_INSTALLER_CHECK=0
while IFS= read -r file; do
    if [[ "$file" =~ ^tool-installer/ ]] || [ "$file" = "vendor/tool-installer" ]; then
        NEED_TOOL_INSTALLER_CHECK=1
        break
    fi
done <<< "$STAGED_FILES"

if [ "$NEED_TOOL_INSTALLER_CHECK" -eq 1 ]; then
    echo "📦 检测到 tool-installer 变更，运行单元测试与 vendor 同步检查..."
    python3 -m unittest discover -s tool-installer/tests
    ./scripts/check-tool-installer-sync.sh
fi

# 4. 如果修改了 manifest.toml 或 tools.toml，检查全平台矩阵与摘要
NEED_MANIFEST_CHECK=0
while IFS= read -r file; do
    if [ "$file" = "manifest.toml" ] || [ "$file" = "tools.toml" ]; then
        NEED_MANIFEST_CHECK=1
        break
    fi
done <<< "$STAGED_FILES"

if [ "$NEED_MANIFEST_CHECK" -eq 1 ]; then
    echo "📋 检测到 manifest/tools 配置变更，运行平台覆盖矩阵检查..."
    ./scripts/check-manifest-platforms.sh
fi

echo "✅ [pre-commit] 所有本地检查通过！"
exit 0
