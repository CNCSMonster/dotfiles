% rsync

# 本地同步到指定 SSH Host (自动排除大目录，带进度压缩)
rsync -avzP --exclude={'.git','node_modules','target','.cache'} <src>/ <host>:<dest>/
$ host: grep -E "^Host " ~/.ssh/config 2>/dev/null | awk '{print $2}' | grep -v "[*]" | grep -v "github.com"

# 预演模式 Dry-Run (预览将被传输和删除的文件，不执行实际操作)
rsync -avunP --delete <src>/ <host>:<dest>/
$ host: grep -E "^Host " ~/.ssh/config 2>/dev/null | awk '{print $2}' | grep -v "[*]" | grep -v "github.com"

# 严格镜像同步到 SSH Host (删除目标目录多余文件，保持两端绝对一致)
rsync -avzP --delete <src>/ <host>:<dest>/
$ host: grep -E "^Host " ~/.ssh/config 2>/dev/null | awk '{print $2}' | grep -v "[*]" | grep -v "github.com"

# 远程 SSH Host 增量拉取到本地 (统计信息、断点续传)
rsync -avzP --stats <host>:<src>/ <dest>/
$ host: grep -E "^Host " ~/.ssh/config 2>/dev/null | awk '{print $2}' | grep -v "[*]" | grep -v "github.com"
